{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_upload_bytes": 10485760,
    "read_timeout": "30s",
    "write_timeout": "60s",
    "idle_timeout": "120s",
    "allow_cors": false
  },
  "store": {
    "backend": "sqlite",
    "path": "/var/lib/recall/recall.db",
    "namespace": "default",
    "embedder": {
      "type": "mock",
      "model": "",
      "dimension": 384,
      "api_key_env": "",
      "base_url": "",
      "path": ""
    },
    "chunking": {
      "strategy": "recursive",
      "max_tokens": 512,
      "overlap": 50
    }
  },
  "auth": {
    "enabled": false,
    "api_keys": [],
    "scoped_keys": [],
    "jwt_secret": "",
    "jwt_issuer": "",
    "jwt_audience": ""
  }
}
